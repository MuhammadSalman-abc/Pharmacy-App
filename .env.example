MONGODB_URI=mongodb://127.0.0.1:27017/pharmacy?replicaSet=pharmacy-rs
# Generate a private random token of at least 32 characters. Never commit the real .env.
API_TOKEN=replace-with-a-private-random-token-at-least-32-characters
PORT=5000
HOST=127.0.0.1
# Set this to the exact frontend origin when connecting the UI.
UI_ORIGIN=http://127.0.0.1:3000
